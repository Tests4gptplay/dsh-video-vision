{
  "manifest_version": 3,
  "name": "DSH 本地会话桥",
  "version": "0.1.0",
  "description": "使用浏览器官方接口，在本机为 DSH 复用用户授权的站点会话。",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DSH 本地会话桥",
    "default_popup": "popup.html"
  }
}

{
  "name": "dsh-video-vision",
  "version": "0.4.1",
  "description": "Give AI models in DSH online video vision: open Bilibili, YouTube and other video links, inspect timestamped frames, and read captions.",
  "type": "module",
  "license": "MIT",
  "author": "Tests4gptplay",
  "repository": { "type": "git", "url": "git+https://github.com/Tests4gptplay/dsh-video-vision.git" },
  "homepage": "https://github.com/Tests4gptplay/dsh-video-vision#readme",
  "bugs": { "url": "https://github.com/Tests4gptplay/dsh-video-vision/issues" },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-video-vision": "./bin/video-vision.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/cache.mjs && node test/native-ui.mjs && node test/prepare.mjs",
    "setup:resolver": "node bin/prepare.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}

{
  "name": "dsh-video-vision",
  "version": "0.9.0",
  "description": "Watch online videos in DSH with timestamped frames, audio, speech and lyric transcription, and music timing analysis.",
  "type": "module",
  "license": "MIT",
  "author": "Tests4gptplay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/dsh-video-vision.git"
  },
  "homepage": "https://github.com/Tests4gptplay/dsh-video-vision#readme",
  "bugs": {
    "url": "https://github.com/Tests4gptplay/dsh-video-vision/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-video-vision": "./bin/video-vision.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "bin/",
    "resources/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "browser-session/protocol.cjs",
    "browser-session/sync.cjs",
    "browser-session/snapshot.cjs",
    "browser-session/discovery.cjs",
    "browser-session/install-desktop.cjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/cache.mjs && node test/native-ui.mjs && node test/browser-ui.mjs && node test/browser-session.mjs && node test/snapshot.mjs && node test/prepare.mjs && node test/extensions.mjs && node test/audio.mjs && node test/native-session.mjs",
    "setup:resolver": "node bin/prepare.mjs"
  }
}
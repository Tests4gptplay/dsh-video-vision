{
  "name": "dsh-video-vision",
  "version": "0.10.1",
  "description": "Analyze multi-site online and local video with frames, audio, subtitles and speech transcription; resume viewing, reuse site methods, import login state, and cache or export media.",
  "type": "module",
  "license": "MIT",
  "author": "Tests4gptplay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tests4gptplay/dsh-video-vision.git"
  },
  "homepage": "https://github.com/Tests4gptplay/dsh-video-vision#readme",
  "bugs": {
    "url": "https://github.com/Tests4gptplay/dsh-video-vision/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-video-vision": "./bin/video-vision.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "bin/",
    "resources/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "browser-session/protocol.cjs",
    "browser-session/snapshot.cjs",
    "browser-session/discovery.cjs",
    "browser-session/platform/",
    "browser-session/keyring-storage.cjs",
    "browser-session/cdp-source.cjs",
    "browser-session/cdp-session.cjs",
    "SPONSOR.md",
    "browser-session/playwright-source.cjs",
    "browser-session/playwright-capture.cjs",
    "browser-session/playwright-worker.cjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@napi-rs/keyring": "^2.1.2",
    "playwright-core": "1.64.0-alpha-1790635538000"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "setup:resolver": "node bin/prepare.mjs"
  }
}
